<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Explicit parents also prevent AAPT treating TextAppearance.Pivoskan as missing. -->
    <style name="TextAppearance.Pivoskan" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/type_body</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="TextAppearance.Pivoskan.Display" parent="TextAppearance.Pivoskan">
        <item name="android:textSize">@dimen/type_display</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.025</item>
        <item name="lineHeight">39sp</item>
    </style>
    <style name="TextAppearance.Pivoskan.H1" parent="TextAppearance.Pivoskan">
        <item name="android:textSize">@dimen/type_h1</item>
        <item name="android:textStyle">bold</item>
        <item name="lineHeight">32sp</item>
    </style>
    <style name="TextAppearance.Pivoskan.H2" parent="TextAppearance.Pivoskan">
        <item name="android:textSize">@dimen/type_h2</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="lineHeight">26sp</item>
    </style>
    <style name="TextAppearance.Pivoskan.Title" parent="TextAppearance.Pivoskan">
        <item name="android:textSize">@dimen/type_title</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="lineHeight">23sp</item>
    </style>
    <style name="TextAppearance.Pivoskan.Body" parent="TextAppearance.Pivoskan">
        <item name="android:textSize">@dimen/type_body</item>
        <item name="lineHeight">22sp</item>
    </style>
    <style name="TextAppearance.Pivoskan.Caption" parent="TextAppearance.Pivoskan">
        <item name="android:textSize">@dimen/type_caption</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="lineHeight">19sp</item>
    </style>
    <style name="TextAppearance.Pivoskan.Price" parent="TextAppearance.Pivoskan">
        <item name="android:textSize">@dimen/type_price</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="lineHeight">30sp</item>
    </style>
    <style name="TextAppearance.Pivoskan.Overline" parent="TextAppearance.Pivoskan">
        <item name="android:textSize">@dimen/type_overline</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="lineHeight">16sp</item>
    </style>
    <style name="TextAppearance.Pivoskan.Brand" parent="TextAppearance.Pivoskan.Overline">
        <item name="android:textSize">@dimen/type_brand</item>
        <item name="android:letterSpacing">0.24</item>
        <item name="android:textColor">@color/gold</item>
    </style>
    <style name="TextAppearance.Pivoskan.Button" parent="TextAppearance.Pivoskan.Body">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.Pivoskan.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:paddingTop">@dimen/space_md</item>
        <item name="android:paddingBottom">@dimen/space_md</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.Pivoskan.Button</item>
        <item name="cornerRadius">@dimen/radius_control</item>
        <item name="iconSize">@dimen/icon_size</item>
    </style>
    <style name="Widget.Pivoskan.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.Pivoskan.Button</item>
        <item name="cornerRadius">@dimen/radius_control</item>
        <item name="iconSize">@dimen/icon_size</item>
    </style>
    <style name="Widget.Pivoskan.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.Pivoskan.Button</item>
    </style>
    <style name="Widget.Pivoskan.CityInput" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">@dimen/radius_control</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_control</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_control</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_control</item>
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="hintTextColor">@color/text_secondary</item>
        <item name="hintTextAppearance">@style/TextAppearance.Pivoskan.Caption</item>
        <item name="endIconDrawable">@drawable/ic_chevron</item>
        <item name="endIconTint">@color/text_secondary</item>
        <item name="endIconMinSize">@dimen/touch_target_min</item>
    </style>
    <style name="Widget.Pivoskan.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">@dimen/outline_width</item>
    </style>
    <style name="Widget.Pivoskan.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipMinHeight">@dimen/chip_height</item>
        <item name="chipMinTouchTargetSize">@dimen/touch_target_min</item>
        <item name="ensureMinTouchTargetSize">true</item>
        <item name="android:textAppearance">@style/TextAppearance.Pivoskan.Caption</item>
    </style>
</resources>
