<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/detailsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:background="@color/bg"
        app:navigationContentDescription="@string/details_back"
        app:title="@string/details_title"
        app:titleTextAppearance="@style/TextAppearance.Pivoskan.H2"
        app:titleTextColor="@color/text_primary" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/detailsScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <View
                    android:id="@+id/storeDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:importantForAccessibility="no" />
                <TextView
                    android:id="@+id/storeName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:letterSpacing="0.08"
                    android:textAllCaps="true"
                    android:textAppearance="@style/TextAppearance.Pivoskan.Caption"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <TextView
                android:id="@+id/beerTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textAppearance="@style/TextAppearance.Pivoskan.H1"
                android:textColor="@color/text_primary"
                android:textSize="26sp" />
            <TextView
                android:id="@+id/beerMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAppearance="@style/TextAppearance.Pivoskan.Body"
                android:textColor="@color/text_secondary" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/details_regular_price"
                android:textAppearance="@style/TextAppearance.Pivoskan.Caption"
                android:textColor="@color/text_secondary" />
            <TextView
                android:id="@+id/price"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="@style/TextAppearance.Pivoskan.Price"
                android:textColor="@color/text_primary"
                android:textSize="34sp" />
            <LinearLayout
                android:id="@+id/discountRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/oldPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Pivoskan.Body"
                    android:textColor="@color/text_secondary" />
                <TextView
                    android:id="@+id/discount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_pill_discount"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:textAppearance="@style/TextAppearance.Pivoskan.Caption"
                    android:textColor="@color/on_gold_container" />
            </LinearLayout>
            <TextView
                android:id="@+id/cardPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.Pivoskan.Body"
                android:textColor="@color/text_primary" />
            <TextView
                android:id="@+id/validUntil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.Pivoskan.Caption"
                android:textColor="@color/text_secondary" />
            <TextView
                android:id="@+id/priceScope"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textAppearance="@style/TextAppearance.Pivoskan.Body"
                android:textColor="@color/text_primary" />
            <TextView
                android:id="@+id/sourceName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.Pivoskan.Caption"
                android:textColor="@color/text_secondary" />
            <TextView
                android:id="@+id/fetchedAt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAppearance="@style/TextAppearance.Pivoskan.Caption"
                android:textColor="@color/text_secondary" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/openSource"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="52dp"
                android:paddingVertical="12dp"
                android:text="@string/details_open_source"
                android:textAppearance="@style/TextAppearance.Pivoskan.Body"
                android:textColor="@color/gold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="16dp"
                app:strokeColor="@color/outline" />

            <TextView
                android:id="@+id/mapHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/details_map_heading"
                android:textAppearance="@style/TextAppearance.Pivoskan.H2"
                android:textColor="@color/text_primary" />
            <TextView
                android:id="@+id/mapNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/details_map_demo"
                android:textAppearance="@style/TextAppearance.Pivoskan.Caption"
                android:textColor="@color/text_secondary" />
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/mapCard"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/map_block"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/outline"
                app:strokeWidth="1dp">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <ru.pivoskan.app.ui.CityMapView
                        android:id="@+id/cityMap"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground" />
                    <TextView
                        android:id="@+id/mapAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_margin="10dp"
                        android:background="@color/surface"
                        android:ellipsize="end"
                        android:importantForAccessibility="no"
                        android:maxLines="1"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp"
                        android:textAppearance="@style/TextAppearance.Pivoskan.Caption"
                        android:textColor="@color/text_primary" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/openMaps"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="52dp"
                android:paddingVertical="12dp"
                android:text="@string/details_open_maps"
                android:textAppearance="@style/TextAppearance.Pivoskan.Body"
                android:textColor="@color/gold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_nav"
                app:iconGravity="textStart"
                app:iconTint="@color/gold"
                app:strokeColor="@color/outline" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/copyAddress"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/details_copy_address"
                android:textAppearance="@style/TextAppearance.Pivoskan.Body"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/addressHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/details_address_heading"
                android:textAppearance="@style/TextAppearance.Pivoskan.H2"
                android:textColor="@color/text_primary" />
            <TextView
                android:id="@+id/address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textAppearance="@style/TextAppearance.Pivoskan.Body"
                android:textColor="@color/text_primary"
                android:textIsSelectable="true" />
            <TextView
                android:id="@+id/hours"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAppearance="@style/TextAppearance.Pivoskan.Body"
                android:textColor="@color/text_secondary" />
            <LinearLayout
                android:id="@+id/comparisonSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/comparisonHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/details_comparison_heading"
                    android:textAppearance="@style/TextAppearance.Pivoskan.H2"
                    android:textColor="@color/text_primary" />
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/comparisonList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@color/surface_variant"
                android:padding="16dp"
                android:text="@string/details_disclaimer"
                android:textAppearance="@style/TextAppearance.Pivoskan.Caption"
                android:textColor="@color/text_secondary" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
